# ============================================================
# ÁLVAREZ DIGITAL — Variables de entorno
# Copia este archivo como .env.local y rellena los valores
# NUNCA subas .env.local a GitHub
# ============================================================

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu-anon-key-aqui
SUPABASE_SERVICE_ROLE_KEY=tu-service-role-key-aqui

# --- Sitio ---
NEXT_PUBLIC_SITE_URL=https://alvarezdigital.com
# En desarrollo usar: http://localhost:3000

# --- Google Adsense ---
# Cuando Adsense esté aprobado, agrega tu client ID
# NEXT_PUBLIC_ADSENSE_CLIENT=ca-pub-XXXXXXXXXXXXXXXXX

# --- Analytics (opcional) ---
# NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX
